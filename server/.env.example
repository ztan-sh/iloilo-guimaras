# Copy to .env and fill in your backend settings. Keep real credentials private.
# Port 5001 avoids the macOS service using port 5000 on this development Mac.
PORT=5001

# MongoDB connection string for your development database.
# Username/password are optional reference fields; the server uses MONGO_URI.
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGO_URI=

# Use your existing JWT signing secret, or generate a random one locally.
JWT_SECRET=bd08bc9f25e97876801ae2c6e974274146914751360007f028e636354677a241f3ce7dbd60fe579e7aeba1426c4941c622ff7b517ed9b352214c66fc163b90b5

# Optional: required only when registering an administrator.
ADMIN_REGISTRATION_CODE=

# Password reset and other account email notifications (Resend)
RESEND_API_KEY=
EMAIL_FROM=
# Public website origin used when constructing password reset links
CLIENT_URL=http://localhost:5173
# Local-only: show a reset link on-screen when email is not configured.
# Keep false in production; this bypasses email ownership for local testing.
ENABLE_DEV_PASSWORD_RESET_LINK=false
