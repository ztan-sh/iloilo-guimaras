# Copy to .env and fill in your backend settings. Keep real credentials private.
# Local backend port
PORT=5000
NODE_ENV=development

# MongoDB connection string for your development database.
# Username/password are optional reference fields; the server uses MONGO_URI.
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGO_URI=

# Generate a private random secret. Never commit or share it.
JWT_SECRET=

# Optional: required only when registering an administrator.
ADMIN_REGISTRATION_CODE=

# Account email delivery (Resend)
RESEND_API_KEY=
EMAIL_FROM=GuimarasGo <no-reply@your-verified-domain.com>
# Optional Gmail API sender (credentials belong only in the backend host's private env).
# Google Cloud OAuth client type: Web application. Exact callback URL:
# https://iloilo-guimaras.onrender.com/api/admin/email/gmail/callback
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=https://iloilo-guimaras.onrender.com/api/admin/email/gmail/callback
GMAIL_SENDER_EMAIL=guimarasgo2026@gmail.com
# Generate GMAIL_OAUTH_STATE_SECRET and GMAIL_TOKEN_ENCRYPTION_KEY locally.
GMAIL_OAUTH_STATE_SECRET=
GMAIL_TOKEN_ENCRYPTION_KEY=
# Public website origin used to build verification and password reset links
CLIENT_URL=http://localhost:5173
# Exact browser origins allowed to use cookie-based sessions (comma-separated)
WEB_ORIGINS=http://localhost:5173
# Local-only: show a reset link on-screen when email is not configured.
# Keep false in production; this bypasses email ownership for local testing.
ENABLE_DEV_PASSWORD_RESET_LINK=false
